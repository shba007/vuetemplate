{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VueTemplate",
  "version": "0.1.0",
  "identifier": "com.tauri.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "dotenvx run -f .env.native -- vp dev",
    "beforeBuildCommand": "dotenvx run -f .env.native -- vp build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "visible": true,
        "url": "/",
        "title": "VueTemplate",
        "width": 1400,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}