{
  "name": "vuetemplate",
  "version": "0.0.8",
  "private": true,
  "description": "Vue + Typescript + Tailwind + Tauri Template",
  "license": "MIT",
  "author": "Shirsendu Bairagi <shirsendu2001@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shba007/vuetemplate.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "vp dev",
    "detect": "gitleaks git --verbose",
    "lint": "vp lint . --fix",
    "format": "vp fmt src/",
    "test:unit": "vp test",
    "build": "vp build",
    "preview": "vp preview",
    "clean": "(cd src-tauri && cargo clean)",
    "docker:build": "docker build --build-arg VERSION=dev --build-arg BUILD_TIME=now -t vuetemplate:dev .",
    "docker:start": "docker run --detach --name vuetemplate-dev --env-file .env.prod -p 2000:8080 vuetemplate:dev",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:dev:mobile": "tauri android dev",
    "tauri:build:mobile": "tauri android build"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.38.2",
    "@tauri-apps/plugin-process": "~2.4.0",
    "@tauri-apps/plugin-updater": "~2.14.1",
    "@vueuse/core": "^15.0.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plus": "1.5.0",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0"
  },
  "engines": {
    "bun": "^1.2.9",
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0",
    "pnpm": "^9.15.0 || ^10.2.0 || ^11.0.0"
  },
  "packageManager": "bun@1.4.4"
}